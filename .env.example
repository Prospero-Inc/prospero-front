# Secret NextAuth uses to sign session JWTs/cookies.
NEXTAUTH_SECRET=
# Same value as NEXTAUTH_SECRET — some next-auth helpers read AUTH_SECRET instead.
AUTH_SECRET=

# Public-facing URL of this app (what the browser uses). Also used server-side
# by the NextAuth API route itself to build sign-in/sign-out redirect URLs.
NEXTAUTH_URL=

# Only needed when the port this app is reachable on differs from the port it
# actually listens on internally (e.g. Docker Compose mapping 3000->4000):
# getServerSideProps' getSession({req}) does a self-fetch to this app's own
# /api/auth/session from the server side, using this instead of NEXTAUTH_URL
# when set. Leave unset for a plain local `pnpm dev` setup.
NEXTAUTH_URL_INTERNAL=

# Base URL of the prospero-backend API (include the /api prefix).
NEXT_PUBLIC_API_URL=
